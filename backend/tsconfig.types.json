{
  // The routes' type for the frontend (AppType, step 2.5): declarations only, no code, into
  // dist/types/. The frontend's own build runs this first, because Vercel never runs the
  // backend's build and an old copy would let a renamed route pass the frontend build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types"
  },
  "include": [], // everything app.ts imports is followed from it
  "files": ["app.ts"]
}

{
  "name": "@frankdmosquera/booking-component",
  "version": "0.2.10",
  "private": true,
  "description": "The booking window every client site installs and builds into its own files.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankdmosquera/scheduleads.git",
    "directory": "packages/booking-component"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./site-colours": {
      "types": "./dist/site-colours.d.ts",
      "default": "./dist/site-colours.js"
    },
    "./booking-component.css": "./booking-component.css"
  },
  "files": [
    "dist",
    "booking-component.css"
  ],
  "scripts": {
    "prebuild": "tsc -p ../shared/tsconfig.build.json && npm run build:types --workspace=backend",
    "build": "tsc -p tsconfig.json && tsdown && node check-dist-imports.mjs",
    "prepack": "npm run build",
    "pack:site": "node pack-into-site.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@scheduleads-app/shared": "*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "backend": "*",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

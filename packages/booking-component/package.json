{
  "name": "@frankdmosquera/booking-component",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./booking-component.css": "./booking-component.css"
  },
  "files": [
    "dist",
    "booking-component.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prebuild": "tsc -p ../shared/tsconfig.build.json && npm run build:types --workspace=backend",
    "build": "tsc -p tsconfig.json && tsdown && node check-dist-imports.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@scheduleads-app/shared": "*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "backend": "*",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

# Where the package is published: GitHub Packages, private to the account. Read only by the publish
# command in AGENTS.md (--userconfig). It holds no secret: the token comes from NODE_AUTH_TOKEN,
# set for that one command from `gh auth token`, and is never written to a file.
@frankdmosquera:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

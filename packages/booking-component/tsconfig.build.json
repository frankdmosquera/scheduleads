{
  // The build: the component compiled to dist/ with its types. Each file's "use client" stays at
  // its top, so a Next host's server components can render the provider and the button.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"] // tests run through Vitest, never shipped in dist/
}

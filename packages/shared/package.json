{
  "name": "@scheduleads-app/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": {
      "types": "./dist/db/drizzle-schema.d.ts",
      "default": "./dist/db/drizzle-schema.js"
    },
    "./subscriptions": {
      "types": "./dist/subscriptions/subscription-limits.d.ts",
      "default": "./dist/subscriptions/subscription-limits.js"
    },
    "./zod-validation": {
      "types": "./dist/zod-validation/index.d.ts",
      "default": "./dist/zod-validation/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsc && node --env-file-if-exists=../../.env scripts/seed-dev.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

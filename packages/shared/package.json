{
  "name": "@scheduleads-app/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": {
      "types": "./dist/db/schema.d.ts",
      "default": "./dist/db/schema.js"
    },
    "./config": {
      "types": "./dist/config/plan-limits.d.ts",
      "default": "./dist/config/plan-limits.js"
    },
    "./validation": {
      "types": "./dist/validation/auth.d.ts",
      "default": "./dist/validation/auth.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2"
  }
}

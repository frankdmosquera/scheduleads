{
  "name": "@scheduleads-app/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./subscriptions": {
      "types": "./dist/subscriptions/subscription-limits.d.ts",
      "default": "./dist/subscriptions/subscription-limits.js"
    },
    "./zod-validation": {
      "types": "./dist/zod-validation/index.d.ts",
      "default": "./dist/zod-validation/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/to-slug.d.ts",
      "default": "./dist/helpers/to-slug.js"
    },
    "./assert-local-dev-database": {
      "types": "./dist/helpers/assert-local-dev-database.d.ts",
      "default": "./dist/helpers/assert-local-dev-database.js"
    },
    "./crypto": {
      "types": "./dist/crypto/token-cipher.d.ts",
      "default": "./dist/crypto/token-cipher.js"
    },
    "./calendar": {
      "types": "./dist/calendar/calendar-connect-outcomes.d.ts",
      "default": "./dist/calendar/calendar-connect-outcomes.js"
    },
    "./crm": {
      "types": "./dist/crm/index.d.ts",
      "default": "./dist/crm/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env scripts/seed-dev.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  // Only src/ is compiled. drizzle.config.ts sits at the package root on
  // purpose: drizzle-kit runs it through its own loader, and including it
  // here would drag it into dist/ and break rootDir.
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"] // tests run through Vitest, never shipped in dist/
}

# Copy to .env at the REPO ROOT and fill in. Not .env.local: the backend loads
# ../.env and drizzle-kit loads ../../.env, so a .env.local is read by nothing.
# The frontend gets its own .env.local later, at build-plan step 1.5.

# Backend
PORT=3001

# Postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# better-auth. BETTER_AUTH_URL is the API origin, not the app origin: Better
# Auth is mounted on the Hono API, so callbacks and cookies are built from 3001.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# The dashboard origin. The only origin allowed to send credentials to the API.
# Kept separate from WIDGET_ORIGINS, which must never carry a session cookie.
APP_ORIGIN=http://localhost:3000

# Production only: the shared parent domain for the session cookie, e.g.
# ".example.com" when the app is app.example.com and the API is api.example.com.
# Leave blank locally.
COOKIE_DOMAIN=

# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# Object storage. R2 speaks the S3 API, so the same client works for both.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
NEXT_PUBLIC_S3_PUBLIC_URL=

# Platform volume. A local folder in development, the mount path in production.
STORAGE_DIR=./data

# Resend
RESEND_API_KEY=

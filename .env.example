# Copy to .env.local (or .env) and fill in.

# Backend
PORT=3001

# Postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# Object storage. R2 speaks the S3 API, so the same client works for both.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
NEXT_PUBLIC_S3_PUBLIC_URL=

# Platform volume. A local folder in development, the mount path in production.
STORAGE_DIR=./data

# Resend
RESEND_API_KEY=

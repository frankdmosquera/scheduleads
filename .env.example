# Copy to .env at the REPO ROOT and fill in. Not .env.local: the backend loads
# ../.env and drizzle-kit loads ../../.env, so a .env.local here is read by
# nothing.
#
# One exception, and it catches people out: NEXT_PUBLIC_API_URL below is read
# by Next, which only loads env files from inside frontend/. See its note.
#
# Every variable listed here is either read by code that exists today or says
# which build-plan item claims it. A variable in an example
# file that nothing reads and nothing claims teaches the next person to
# configure something that does nothing, so the scaffolder's ImageKit, S3 and
# volume blocks were removed at build-plan step 1.6 rather than left empty.
# The packages are still installed; nothing imports them. They come back with
# the item that needs them, which today is only "photo attachments on a lead",
# and that is named, not planned.

# Backend
PORT=3001

# Postgres. In development this is a local PostgreSQL 18 on this machine, in
# a database whose name ends in _dev: build it with db:migrate, then run
# db:seed for the two development accounts. See Commands in AGENTS.md.
DATABASE_URL=postgresql://postgres:pass@127.0.0.1:5432/scheduleads_dev
#
# Railway's database, only when working against it on purpose: switch the line
# above off and this one on, and open the tunnel first with
# `railway connect Postgres --tunnel-only --port 5433`. Never
# postgres.railway.internal, which only resolves inside Railway. When 5433
# refuses the connection the tunnel is not running; when it listens but every
# query resets, stop the tunnel and open it again.
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5433/railway

# better-auth. BETTER_AUTH_URL is the API origin, not the app origin: Better
# Auth is mounted on the Hono API, so callbacks and cookies are built from 3001.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# The dashboard origin. The only origin allowed to send credentials to the API.
# Kept separate from WIDGET_ORIGINS, which must never carry a session cookie:
# a site that could attach the owner's cookie to a request could act as the
# owner.
APP_ORIGIN=http://localhost:3000

# Production only: the shared parent domain for the session cookie, e.g.
# ".example.com" when the app is app.example.com and the API is api.example.com.
# The two must sit under one registrable domain or the session is dropped.
# Leave blank locally, where the cookie stays SameSite=Lax.
COOKIE_DOMAIN=

# Where the browser reaches the API. Public by definition, which is why it is
# the only NEXT_PUBLIC_* variable this project has. Never put a secret behind
# that prefix; the prefix means "inline this into the bundle".
#
# READ BY NEXT, NOT BY THIS FILE. Next only loads env files from inside
# frontend/, so locally it belongs in frontend/.env.local, or is left unset:
# the auth client falls back to http://localhost:3001 in development. In
# production Vercel injects it and there is no file. It is listed here so the
# full set of variables is in one place.
NEXT_PUBLIC_API_URL=http://localhost:3001

# The client sites allowed to call the public booking routes, comma separated.
# Read by the public booking routes. Credentials are never
# allowed on these origins, which is the whole reason it is not APP_ORIGIN.
WIDGET_ORIGINS=

# The agency's own Resend account, which sends login codes (feature 6,
# decision 7), and the address they come from: "Agency name <login@domain>"
# or a bare address, at a domain verified in that account. Each business's
# booking emails go through the business's own Resend account instead, with a
# key stored in the database, never here. Leave both empty in development and
# codes print to the API console; production refuses to start without both.
RESEND_API_KEY=
LOGIN_EMAIL_FROM=

# The lock on stored calendar tokens: 32 random bytes in base64, made with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The API refuses to start without it. Each environment has its own; Railway's
# is set there at deploy. Losing it makes every stored calendar connection
# unreadable and everyone connects again, so keep it with the other secrets.
CALENDAR_TOKEN_KEY=

# Signs every booking's private link, the one in the customer's confirmation
# that opens their booking: 32 random bytes in base64, made the same way. The
# API refuses to start without it. Nothing is stored with it: changing it ends
# every link already sent, and losing it does the same.
BOOKING_LINK_KEY=

# Google's OAuth client for connecting a calendar, from Google Cloud: Google Auth
# Platform, Clients, a "Web application" client in Testing mode, your Gmail as a
# test user, and the redirect http://localhost:3001/calendar/callback. Google
# shows the secret once; a lost one is replaced with "Add secret". The API
# refuses to start without both.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=backend",
    "watchPatterns": [
      "/backend/**",
      "/packages/shared/**",
      "/package.json",
      "/package-lock.json",
      "/railway.json",
      "/.node-version"
    ]
  },
  "deploy": {
    "startCommand": "node backend/dist/server.js",
    "healthcheckPath": "/health",
    "drainingSeconds": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
